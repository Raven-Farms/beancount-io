;; fixture — beancount-close eval8 (three active accounts, statements for two)
option "operating_currency" "USD"

2026-01-01 open Assets:Bank:Checking USD
2026-01-01 open Assets:Bank:Savings USD
2026-01-01 open Liabilities:CreditCard:Amex USD
2026-01-01 open Income:Interest USD
2026-01-01 open Expenses:Food:Groceries USD
2026-01-01 open Expenses:Dining USD
2026-01-01 open Equity:Opening-Balances

2026-05-31 * "Opening balance"
  Assets:Bank:Checking      1000.00 USD
  Equity:Opening-Balances

2026-05-31 * "Opening balance"
  Assets:Bank:Savings        500.00 USD
  Equity:Opening-Balances

2026-06-01 balance Assets:Bank:Checking   1000.00 USD
2026-06-01 balance Assets:Bank:Savings     500.00 USD

2026-06-10 * "WHOLE FOODS"
  Assets:Bank:Checking       -50.00 USD
  Expenses:Food:Groceries

2026-06-15 * "Interest"
  Assets:Bank:Savings        100.00 USD
  Income:Interest

2026-06-12 * "BISTRO NOVA"
  Liabilities:CreditCard:Amex  -30.00 USD
  Expenses:Dining              30.00 USD
